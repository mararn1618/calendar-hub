{
  "name": "calendar-central",
  "productName": "Calendar Central",
  "version": "0.1.0",
  "description": "A Mac calendar for TickTick tasks, Google appointments and work meetings",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node scripts/build-mac-helper.mjs && electron .",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:e2e": "node tests/desktop-e2e.mjs",
    "test:live": "node tests/live-desktop.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "playwright-core": "1.65.1"
  }
}
